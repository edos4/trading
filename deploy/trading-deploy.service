[Unit]
Description=Trading Bot deploy gateway + Cloudflare Tunnel
Documentation=file://@ROOT_DIR@/README.md
# Keep restarting forever: survive reboots, crashes and crash loops.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@ROOT_DIR@
ExecStart=@ROOT_DIR@/run_deploy.sh --require-tunnel
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
