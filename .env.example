# ── IBKR ──────────────────────────────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497               # 7497 = paper | 7496 = live
IBKR_CLIENT_ID=1

# ── Trading mode ───────────────────────────────────────────────────────────────
TRADING_MODE=paper           # "paper" or "live" — change explicitly when ready
# Market profile: us (NASDAQ/NYSE, USD) or ph (PSE, PHP, long-only, Manila clock).
# UI/web Backtest and Paper screens can still pick a market per run.
MARKET=us

# ── Risk limits ────────────────────────────────────────────────────────────────
# Swing trading: 8 concurrent names max; 0 = unlimited (not recommended).
MAX_DAILY_LOSS_USD=1500
MAX_DAILY_LOSS_PHP=15000
MAX_OPEN_POSITIONS=4
# Max concurrent seats in any one pattern (0 = unlimited).
MAX_OPEN_PER_PATTERN=2
# Skip fills whose notional is below this after risk/exposure caps.
MIN_POSITION_NOTIONAL=1000

# ── Collect-first (rank by reward:risk, open only top-N) ─────────────────────
# Off by default. When on, each scan collects chart-pattern signals without
# opening anything, ranks them by reward:risk, and opens only the top
# COLLECT_FIRST_TOP_N. Kronos/volume/vision gates run only on the winners.
COLLECT_FIRST_ENABLED=false
COLLECT_FIRST_TOP_N=4

# ── Market scanner ─────────────────────────────────────────────────────────────
# Comma-separated list of symbols to watch
WATCHLIST=AAPL,MSFT,NVDA,SPY
# Screener: america, crypto, forex, cfd
TV_SCREENER=america
# Exchange hint for TradingView screener / MCP (SPY uses AMEX automatically)
TV_EXCHANGE=NASDAQ
# Daily bars from Yahoo chart API (2y range) + screener overlay. PH falls back
# to PSE Edge when Yahoo *.PS returns a YHD stub. Need ≥400 for Kronos LOOKBACK.
TV_HISTORY_DAYS=450
# How often to run the scan loop (seconds). 1d/1w patterns only detect and
# fill on a newly *closed* cash session (US after 16:00 ET) — hourly polls
# still mark prices but do not count as new daily bars.
SCAN_INTERVAL_SECONDS=3600
# How many symbols to scan concurrently. Each worker opens its own MCP session.
# Screener POSTs are still paced globally by TV_SCREENER_MIN_INTERVAL_SECONDS.
SCANNER_CONCURRENCY=10
# Pattern analyze() process workers. 0 = auto (2–8 from CPU count). 1 = inline
# on the scan loop. Paper ledger / Kronos / vision never run in these workers.
SCANNER_ANALYZE_WORKERS=0
# Min gap between TradingView scanner POSTs (seconds). 0.5 ≈ 2 req/s — safer
# than unrestricted concurrency, which trips HTTP 429 mid-scan (~1000 symbols).
TV_SCREENER_MIN_INTERVAL_SECONDS=0.5
# Retries + base backoff (seconds, doubles each attempt) on HTTP 429.
TV_SCREENER_MAX_RETRIES=5
TV_SCREENER_RETRY_BACKOFF_SECONDS=2.0

# ── Vision confirmation ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Set to false to skip visual confirmation (faster, less API cost)
VISION_CONFIRMATION_ENABLED=true
# Minimum indicator confidence (0.0–1.0) required before even running vision check
VISION_MIN_INDICATOR_CONFIDENCE=0.6

# ── Kronos feature switch (all frontends) ────────────────────────────────
# Master switch for Kronos. When false, `main.py --ui` and `main.py --web`
# hide every Kronos control (nav tab, explorer gate, paper gate/rank, backtest
# fields, predict page) and force the Kronos gate/rank off for runs started
# there. The CLI flags are unaffected. Set true to expose Kronos again.
ENABLE_KRONOS=false
# ── Kronos confirm gate (3% in 3 trading days on chart-pattern signals) ─
# Requires ~/Kronos weights (see README). Fail-closed if missing.
# Only reachable through the UI/web while ENABLE_KRONOS=true.
KRONOS_GATE_ENABLED=true
# Keep false until proven: overwriting pattern TP/SL made paper ≠ backtest.
KRONOS_GATE_ADJUST_EXITS=false
# Minimum |predicted 3d close-to-close|; 0.03 = 3% in 3 days.
KRONOS_MIN_MOVE_PCT=0.03
KRONOS_SAMPLE_COUNT=3
# Collect pattern hits then KronosPredictor.predict_batch. Off unless the
# UI/web "Batch Kronos" checkbox is on (only shown when Kronos is enabled).
KRONOS_BATCH_ENABLED=false
# Series per GPU batch (GPU batch = this × KRONOS_SAMPLE_COUNT).
# No CUDA: runtime caps this at 4.
KRONOS_BATCH_SIZE=16
# Use finetuned weights under ~/Kronos/finetuned when present (else base).
KRONOS_USE_FINETUNED=false

# ── Kronos ranked forecast sleeve (top-K by 3d pred — beside patterns) ───────
# Off by default. Enable after validating with backtest kronos_rank checkbox.
# Same 3% in 3 days floor as the confirm gate unless overridden below.
KRONOS_RANK_ENABLED=false
KRONOS_RANK_TOP_K=3
KRONOS_RANK_BOTTOM_K=3
KRONOS_RANK_LONG_ONLY=true
# Optional override of KRONOS_MIN_MOVE_PCT for sleeve entries only:
# KRONOS_RANK_MIN_MOVE_PCT=0.03
# Bars between cross-sectional re-ranks in backtest (5 ≈ weekly)
KRONOS_RANK_REBALANCE_BARS=5

# ── Volume confirm gate (RVOL + OBV direction filter on chart-pattern signals) ─
# On by default after 2026-08-17 US paper (Kronos alone did not filter 003 losers).
# Fail-open on short/missing volume history.
VOLUME_GATE_ENABLED=true
VOLUME_GATE_RVOL_MIN=2.0
VOLUME_GATE_OBV_BARS=5

# ── Paper trade stream (stocks_history replay when markets closed; UI checkbox) ─
# PAPERTRADE_STREAM_START_DATE=2025-01-02   # YYYY-MM-DD; UI datepicker / --stream overrides
# CLI replay: python main.py --paper --symbols=500 --pattern-only --collect-first=4 \
#   --stream=01/05/2026 --duration-days=30 --export-trades-log=output_trades.json
# PAPERTRADE_STREAM_INTERVAL_SECONDS=0     # 0 = next day as soon as scan finishes
# PAPERTRADE_STREAM_BATCH_SIZE=50          # symbols per WS round-trip
# PAPERTRADE_STREAM_PRELOAD_WORKERS=16     # parallel 33ai fetches on stream start

# ── Web UI (python main.py --web) — required for VPS deploy ───────────────────
# WEB_UI_PASSWORD must be set; the server will not start without it.
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8080
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=change-me-to-a-long-random-secret
# Optional: long random string for cookie signing (recommended in production).
# WEB_UI_SECRET_KEY=
# Force the session cookie Secure. Normally left false: when the request
# arrives over TLS (e.g. via the Cloudflare Tunnel edge) the cookie is flagged
# Secure automatically from X-Forwarded-Proto.
WEB_UI_HTTPS=false
WEB_UI_SESSION_HOURS=12

# ── Public web access via Cloudflare Tunnel (run_web.sh) ──────────────────────
# Optional and host-specific. run_web.sh is a plain local server by default;
# it only exposes the UI publicly when BOTH CLOUDFLARE_TUNNEL_TOKEN and
# CLOUDFLARE_TUNNEL_HOSTNAME are set here. When set, it serves the local UI at
# https://${CLOUDFLARE_TUNNEL_HOSTNAME} through a Cloudflare Tunnel driven by the
# `cf` CLI (`cf auth login` once). The tunnel is remotely managed, so its ingress
# rules live in Cloudflare and only the token is needed here. One-time setup
# (replace the example host/zone with your own):
#   cf tunnels create --name <tunnel-name> --config-src cloudflare
#   cf tunnels config update <tunnel-id> --body '{"config":{"ingress":[
#     {"hostname":"<public-host>","service":"http://localhost:8080"},
#     {"service":"http_status:404"}]}}'
#   cf dns records create --zone <zone> --body '{"type":"CNAME",
#     "name":"<public-host>","content":"<tunnel-id>.cfargotunnel.com",
#     "proxied":true,"ttl":1}'
# The token is printed by `cf tunnels create`; retrieve it later with
#   cf tunnels token get <tunnel-id>
# Leave both unset (or pass `./run_web.sh --no-tunnel`) to stay local-only.
# CLOUDFLARE_TUNNEL_HOSTNAME=33ai.rootlabs.dev   # example
CLOUDFLARE_TUNNEL_TOKEN=

# ── Deploy gateway (optional, host-specific) ──────────────────────────────────
# An authenticated HTTPS webhook: another computer pushes a branch to GitHub,
# then POSTs the ref; the gateway fetches it, syncs deps and restarts the web
# service. The endpoint runs code, so it binds loopback only and refuses to
# start without a token. run_deploy.sh can expose it via its own Cloudflare
# Tunnel (separate from the web UI tunnel above).
#
# One-time setup:  scripts/setup_deploy_tunnel.sh   # create tunnel + DNS, print tokens
#                  scripts/install_deploy_service.sh # user service, survives reboot
#
# Empty token = the gateway refuses to bind; the deploy tunnel is skipped.
# Generate one with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
DEPLOY_GATEWAY_HOST=127.0.0.1
DEPLOY_GATEWAY_PORT=8099
DEPLOY_GATEWAY_TOKEN=
# Repo the gateway updates. Empty = this repo (the directory holding config.py).
# DEPLOY_REPO_DIR=
# Comma-separated branch allowlist. Empty = any branch that exists on origin.
# DEPLOY_ALLOWED_REFS=main
# systemd --user units restarted after a successful checkout. Empty = none.
# DEPLOY_RESTART_UNITS=trading-web.service
# Allow deploying over a dirty working tree (off by default).
# DEPLOY_ALLOW_DIRTY=false
# Cloudflare Tunnel for the gateway (see scripts/setup_deploy_tunnel.sh).
# DEPLOY_ZONE=example.com                          # overrides host-derived zone
# DEPLOY_TUNNEL_NAME=trading-deploy-33ai           # example
# DEPLOY_TUNNEL_HOSTNAME=33ai-deploy.rootlabs.dev  # example
DEPLOY_TUNNEL_TOKEN=
#
# Client side (deploy_to_engine.sh on the other computer):
#   DEPLOY_URL=https://<deploy-hostname>
#   DEPLOY_TOKEN=<same value as DEPLOY_GATEWAY_TOKEN>

# ── Approved pattern-version sandbox ──────────────────────────────────────────
# Executing a stored pattern version needs a delegated cgroup v2 subtree and an
# isolated worker interpreter (see core/pattern_edit_worker.py). Empty = the
# shipped pattern code runs instead of any approved version.
PATTERN_EDIT_CGROUP_ROOT=
PATTERN_EDIT_WORKER_PYTHON=

# ── DeepSeek pattern editing ──────────────────────────────────────────────────
# Server-side credentials. The API model id is `deepseek-flash`; do not change
# it silently — a different model must be configured explicitly.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_CONCURRENCY=2

# ── Remote stocks_history (python main.py --ui / --web) ───────────────────────
# Local --ui/--web (including paper trade stream) always read OHLCV from 33ai.edos.uk.
# You do not need to set STOCKS_HISTORY_URL on a laptop; empty means 33ai.
# On the VPS leave STOCKS_HISTORY_URL empty and set:
# STOCKS_HISTORY_OWNER=true
# so --web still writes local Postgres (--update-db) and serves GET /api/history.
# Reads still go to 33ai (or an explicit STOCKS_HISTORY_URL).
# STOCKS_HISTORY_URL=https://33ai.edos.uk
# Optional; defaults to WEB_UI_USERNAME for both user and password (admin:admin).
# STOCKS_HISTORY_USERNAME=admin
# STOCKS_HISTORY_PASSWORD=

# ── Remote pattern registry (pattern editor / scanner / backtests) ─────────────
# Leave PATTERN_API_URL empty to use the local editor database (default).
# Set it on a client with no local PostgreSQL: pattern versions are then read
# from the VPS API, so the Patterns tab, paper stream and backtests run without
# a database. The host that serves the API sets PATTERN_API_OWNER=true instead.
# PATTERN_API_PASSWORD must be that host's real WEB_UI_PASSWORD: /api/patterns
# uses require_login, so the admin:admin scheme /api/history accepts is refused.
# PATTERN_API_URL=https://33ai.edos.uk
# PATTERN_API_USERNAME=admin
# PATTERN_API_PASSWORD=
# PATTERN_API_OWNER=false

# ── PostgreSQL (stock history DB — `python main.py --check-db/--update-db`) ─
# Local socket + peer auth (OS user r00t maps to role r00t), no password needed.
# Create the DB once:  psql -d postgres -c "CREATE DATABASE stocks_history"
DATABASE_URL=postgresql://r00t@/stocks_history?host=/var/run/postgresql
# Discrete fallbacks (used only when DATABASE_URL is empty):
# DB_HOST=/var/run/postgresql
# DB_PORT=5432
# DB_NAME=stocks_history
# DB_USER=r00t
# DB_PASSWORD=

# ── Notifications (optional) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Pattern Editor PostgreSQL ────────────────────────────────────────────
# Optional separate PostgreSQL DSN; empty reuses DATABASE_URL/db_* above.
# Schema is created only by: .venv/bin/python scripts/migrate_pattern_editor.py
PATTERN_EDITOR_DATABASE_URL=
# Frozen daily-bar dataset for shared backtest runs (offline + stream).
# Files are import inputs only; PostgreSQL stores the frozen run inputs.
# Symbols missing from it are fetched from the history provider and cached here.
# Pre-build a whole universe with scripts/build_barcache.py when you want an
# offline snapshot: a cached symbol never calls the provider.
BACKTEST_DATASET_DIR=data/barcache
# Tests require an explicitly disposable PostgreSQL DB; never reuse production.
# PATTERN_EDITOR_TEST_DATABASE_URL=postgresql:///pattern_editor_test?host=/tmp/your-test-socket
